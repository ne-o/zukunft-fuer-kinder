{
  "name": "zukunft-fuer-kinder",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "user",

  "mounts": [
    // VS Code settings for the container only (task that starts opencode):
    // hides the project's .vscode/ (just a README) inside the container
    "source=${localWorkspaceFolder}/.devcontainer/vscode,target=${containerWorkspaceFolder}/.vscode,type=bind",
    // opencode: login, sessions and settings outside the image (survive a rebuild)
    "source=zfk-opencode-data,target=/home/user/.local/share/opencode,type=volume",
    "source=zfk-opencode-config,target=/home/user/.config/opencode,type=volume",
    // last used models (first start: GLM 5.3 Flash, seeded in the Dockerfile)
    "source=zfk-opencode-state,target=/home/user/.local/state/opencode,type=volume"
  ],

  // `preview` (hugo server --bind 0.0.0.0 --port 1314) -> http://localhost:1314 (CMS: /admin/)
  // (1314 instead of Hugo's default 1313, which is often taken already)
  // `browser` (also started by opencode's browser tools): watch/click it at
  // http://localhost:6080/vnc.html?autoconnect=1&resize=scale
  "forwardPorts": [1314, 6080],
  "portsAttributes": {
    "1314": { "label": "Hugo preview" },
    "6080": { "label": "Browser (noVNC)" },
    // internal: VNC behind noVNC, Chromium's remote control for opencode
    "5900": { "onAutoForward": "ignore" },
    "9222": { "onAutoForward": "ignore" }
  },

  // GitHub Codespaces ignores the bind mount below that puts
  // .devcontainer/vscode/ over .vscode/ (tried 2026-11-14): link the task
  // file instead where it's missing. Locally the mount is there, so this
  // does nothing; the link is in .gitignore.
  "onCreateCommand": "test -e .vscode/tasks.json || ln -s ../.devcontainer/vscode/tasks.json .vscode/tasks.json",

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "DavidAnson.vscode-markdownlint",
        "ecmel.vscode-html-css",
        "github.vscode-github-actions",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-german"
      ],
      "settings": {
        "cSpell.language": "en,de-de",
        // opencode is the assistant here: no Copilot chat side bar on first
        // start, no inline suggestions. (workbench.secondarySideBar.
        // defaultVisibility has no effect from here - tried 2026-11-14.)
        "chat.disableAIFeatures": true,
        "files.associations": { "layouts/**/*.html": "html" }
      }
    }
  }
}
